# ===== LLM 配置（必填）=====
DEEPSEEK_API_KEY=sk-your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 数据库配置（Docker 容器 postgres 映射到宿主机 5432）=====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=equipment_cs
DB_USER=postgres
DB_PASSWORD=postgres

# ===== Milvus 配置（Docker 容器 milvus 映射到宿主机 19530）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== MinIO 配置 =====
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production

# ===== JWT 认证（必填，生产环境生成随机密钥）=====
JWT_SECRET_KEY=change_me_to_a_random_secret_key

# ===== 应用配置 =====
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== LangGraph Checkpointer（诊断追问的暂停/恢复存储）=====
# memory  = 进程内（默认，本地开发够用；重启丢失追问状态）
# postgres = AsyncPostgresSaver（生产推荐，跨进程/重启持久化；PG 不可用时自动降级 memory）
CHECKPOINTER_BACKEND=memory

# ===== 安全 =====
# CORS 允许来源（逗号分隔；生产改为实际前端域名，如 https://ops.example.com）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080
# 单 IP 每分钟请求上限（超出返回 429；按部署规模调整）
RATE_LIMIT_PER_MINUTE=120

# ===== Web 搜索（可选；留空则自动用免费的 DuckDuckGo）=====
TAVILY_API_KEY=
