# ===== LLM 配置（必填）=====
DEEPSEEK_API_KEY=sk-your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 数据库配置（本地默认端口 5433；Docker 内由 compose 注入 postgres:5432）=====
DB_HOST=localhost
DB_PORT=5433
DB_NAME=equipment_cs
DB_USER=postgres
DB_PASSWORD=change_me_in_production

# ===== Milvus 配置（本地默认端口 19531；Docker 内由 compose 注入 milvus:19530）=====
MILVUS_HOST=localhost
MILVUS_PORT=19531

# ===== MinIO 配置 =====
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_in_production

# ===== JWT 认证（必填，生产环境生成随机密钥）=====
JWT_SECRET_KEY=change_me_to_a_random_secret_key

# ===== 应用配置 =====
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== Web 搜索（可选；留空则自动用免费的 DuckDuckGo）=====
TAVILY_API_KEY=
